<%= render SectionComponent.new(title: "Personal", open: false) do %>

  <div data-controller="toggle">

    <!-- ===================== -->
    <!-- VIEW MODE -->
    <!-- ===================== -->
    <div data-toggle-target="view" class="space-y-4">

      <!-- Name -->
      <div class="flex justify-between items-center">
        <div class="font-semibold text-lg">
          <%= "#{current_user.first_name} #{current_user.last_name}" %>
        </div>
        <button
          data-action="click->toggle#show"
          class="font-bold cursor-pointer">
          Edit
        </button>
      </div>

      <!-- Email -->
      <div class="flex justify-between items-center">
        <div class="text-gray-600 text-lg">
          <%= current_user.email %>
        </div>
        <button
          data-action="click->toggle#show"
          class="font-bold cursor-pointer">
          Edit
        </button>
      </div>

      <!-- Password -->
      <div class="flex justify-between items-center">
        <div class="text-gray-600 text-lg">
          Password
        </div>
        <button
          data-action="click->toggle#show"
          class="font-bold cursor-pointer">
          Edit
        </button>
      </div>

    </div>

    <!-- ===================== -->
    <!-- EDIT MODE -->
    <!-- ===================== -->
    <div data-toggle-target="form" class="hidden mt-6">

      <%= form_for(current_user,
            url: registration_path(:user),
            html: { method: :put, class: "space-y-4" }) do |f| %>

        <!-- Name -->
        <div class="grid grid-cols-2 gap-3">
          <%= f.text_field :first_name,
                class: "w-full border border-gray-300 rounded px-3 py-2" %>

          <%= f.text_field :last_name,
                class: "w-full border border-gray-300 rounded px-3 py-2" %>
        </div>

        <!-- Email -->
        <div>
          <%= f.email_field :email,
                class: "w-full border border-gray-300 rounded px-3 py-2" %>
        </div>

        <!-- Password -->
        <div class="pt-4 border-t border-gray-200">
          <p class="text-sm font-semibold mb-3">Change password</p>

          <div class="space-y-3">
            <%= f.password_field :password,
                  placeholder: "New password",
                  class: "w-full border border-gray-300 rounded px-3 py-2 placeholder-gray-400" %>

            <%= f.password_field :password_confirmation,
                  placeholder: "Confirm new password",
                  class: "w-full border border-gray-300 rounded px-3 py-2 placeholder-gray-400" %>

            <%= f.password_field :current_password,
                  placeholder: "Current password",
                  class: "w-full border border-gray-300 rounded px-3 py-2 placeholder-gray-400" %>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-3 pt-2">
          <%= f.submit "Save changes",
                class: "flex-1 bg-black text-white py-2 rounded font-semibold hover:opacity-80 transition cursor-pointer" %>

          <button type="button"
                  data-action="click->toggle#hide"
                  class="flex-1 border border-gray-300 py-2 rounded font-semibold cursor-pointer">
            Cancel
          </button>
        </div>

      <% end %>

    </div>

  </div>

  <!-- Danger Zone -->
  <div class="mt-8 pt-6">

    <%= button_to "Cancel my account",
          registration_path(:user),
          method: :delete,
          data: { turbo_confirm: "Are you sure? This cannot be undone." },
          class: "w-full border border-red-600 text-red-600 py-2 rounded font-semibold hover:bg-red-50 transition" %>
  </div>

<% end %>
