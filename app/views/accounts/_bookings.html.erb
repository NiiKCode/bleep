<% upcoming_bookings = @upcoming_bookings %>

<% completed_bookings = @completed_bookings
  .sort_by(&:session_date)
  .reverse
  .first(20)
%>

<% grouped_completed = completed_bookings.group_by { |b| b.session_type.title } %>


<!-- ========================= -->
<!-- UPCOMING -->
<!-- ========================= -->
<%= render SectionComponent.new(title: "Upcoming", open: true) do %>

  <% if upcoming_bookings.any? %>

    <% upcoming_bookings.each do |booking| %>

      <div class="py-3">

        <div class="font-semibold">

          <%= booking.session_type.title %>

          <% if booking.partner_user.present? %>
            <span class="font-semibold">
              w <%= booking.partner_user.initials %>
            </span>
          <% end %>

        </div>

        <div class="text-sm tracking-widest text-gray-500 mt-1">

          <%= booking.display_location %>

          <span class="uppercase tracking-wider">
            <%= city_code(booking.scheduled_session.location.city) %>
          </span>

        </div>

        <div
          class="
            text-xs
            uppercase
            tracking-widest
            text-gray-500
            mt-1
          "
        >

          <%= formatted_session_date(
                booking.session_date
              ).upcase %>

          /

          <%= booking.time_slot.start_time.strftime("%H.%M") %>–<%= booking.time_slot.end_time.strftime("%H.%M") %>

          /

          £<%= number_to_currency(
                booking.price,
                unit: "",
                precision: 0
              ) %>

        </div>

      </div>

    <% end %>

  <% else %>
    <div class="text-sm text-gray-700 py-2">No upcoming sessions</div>
  <% end %>

<% end %>


<!-- ========================= -->
<!-- COMPLETED (GROUPED) -->
<!-- ========================= -->
<%= render SectionComponent.new(title: "Add score", open: true) do %>

  <% if grouped_completed.any? %>

    <% grouped_completed.each do |session_title, bookings| %>

      <!-- 🔽 Sub-group collapsible -->
      <div data-controller="collapsible" class="py-2">

        <!-- Header -->
        <div
          class="flex justify-between items-center cursor-pointer"
          data-action="click->collapsible#toggle"
        >
          <div class="font-semibold">
            <%= session_title %>
          </div>

          <div
            data-collapsible-target="chevron"
            class="transition-transform"
          >
            ▼
          </div>
        </div>

        <!-- Content -->
        <div
          data-collapsible-target="section"
          class="mt-2 space-y-2 hidden"
        >

          <% bookings.each do |booking| %>
            <div class="flex justify-between items-center py-2">

              <!-- LEFT -->
              <div class="space-y-1">
                <div class="text-sm text-gray-600">
                  <%= booking.session_date.strftime("%a %-d %b") %><br>
                  <%= booking.time_slot.start_time.strftime("%H:%M") %> to
                  <%= booking.time_slot.end_time.strftime("%H:%M") %>
                </div>
              </div>

              <!-- RIGHT -->
              <div class="flex items-center gap-4">

                <div class="flex gap-1">
                  <span class="font-bold"><%= current_user.initials %></span>
                  <% if booking.partner_user %>
                    <span class="font-bold"><%= booking.partner_user.initials %></span>
                  <% end %>
                </div>

                <% if booking.score.present? %>
                  <div class="flex items-center gap-2">
                    <span class="font-bold"><%= booking.score %></span>

                    <%= link_to "Edit",
                        edit_score_booking_path(booking),
                        class: "underline text-sm text-gray-600" %>
                  </div>
                <% else %>
                  <%= link_to "Add",
                      edit_score_booking_path(booking),
                      class: "font-bold underline" %>
                <% end %>

              </div>

            </div>
          <% end %>

        </div>

      </div>

    <% end %>

  <% else %>
    <div class="text-sm text-gray-700 py-2">No completed sessions</div>
  <% end %>

<% end %>
