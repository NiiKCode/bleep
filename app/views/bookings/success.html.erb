<div class="min-h-screen px-6 py-10">

  <h1
    class="
      heading-condensed
      heading-lg
      uppercase
      <%= @payment_status == 'paid' ? 'text-fuchsia-600' : 'text-black' %>
    "
  >
    <%= @payment_status == "paid" ? "PAID" : "PROCESSING..." %>
  </h1>

  <p class="mt-4">
    Your booking has been received.
  </p>

  <% unless @payment_status == "paid" %>

    <p class="mt-4 text-gray-500">
      Final confirmation may take a few seconds.
    </p>

  <% end %>

  <p
    class="
      mt-8
      text-xs
      uppercase
      tracking-widest
      text-gray-500
    "
  >
    Redirecting to account...
  </p>

</div>

<script>
  setTimeout(function() {
    window.location.href = "<%= account_path %>";
  }, 5000);
</script>
