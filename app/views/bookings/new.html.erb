<div class="py-6">

  <h1 class="heading-condensed heading-xl">
    Your booking
  </h1>

  <%= form_with model: @booking,
        url: bookings_path,
        local: true,
        data: { turbo: false } do |f| %>

    <% if @booking.errors.any? %>

      <div class="bg-red-100 p-4 mb-6 rounded-xl">

        <% @booking.errors.full_messages.each do |msg| %>

          <div class="text-red-600">
            <%= msg %>
          </div>

        <% end %>

      </div>

    <% end %>

    <%= f.hidden_field :time_slot_id, value: @time_slot.id %>

    <%= render "summary_card",
          session_type: @session_type,
          location: @location,
          scheduled_session: @scheduled_session,
          time_slot: @time_slot %>

    <%= render "friend_selector",
          current_user: current_user %>

    <div class="mt-4">

      <button
        type="submit"
        data-disable-with="Processing..."
        class="
          w-full
          py-4
          text-xl
          font-extrabold
          bg-black
          text-white
          cursor-pointer
        "
      >
        Confirm and pay
      </button>

    </div>

  <% end %>

</div>
