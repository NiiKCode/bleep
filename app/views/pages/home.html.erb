<%# ✅ Enable full-bleed mode for homepage %>
<% content_for :full_bleed, true %>

<!-- SECTION 1: Hero (FULL BLEED) -->
<section
  class="w-full h-[65vh] sm:min-h-screen lg:min-h-[125vh] flex items-center justify-center bg-cover bg-center overflow-hidden pt-5 sm:pt-20 md:pt-20"
  style="background-image: url('<%= asset_path('homepage_background.png') %>');"
>

  <div class="w-full px-4 sm:px-6">
    <div class="relative z-10 w-full max-w-5xl mx-auto text-center -mt-2 sm:-mt-6 md:-mt-4 lg:-mt-16">

      <h1 class="font-futura font-bold tracking-tight text-center leading-[0.82] mx-auto max-w-[90vw]">
        <span class="block text-[clamp(7rem,20vw,13rem)] text-center">
          <span class="inline-block">
            BE<span class="relative inline-block">
              <span class="relative inline-block">
                AT
                <span style="
                  position: absolute;
                  left: 0;
                  top: 0.3em;
                  width: 100%;
                  height: 0.18em;
                  background: #ec4899;
                  transform: rotate(6deg);
                  z-index: 20;
                  pointer-events: none;
                "></span>
              </span>
            </span>
          </span>
        </span>

        <span class="block text-[clamp(7rem,20vw,13rem)] -mt-1">YOUR</span>
        <span class="block text-[clamp(7rem,20vw,13rem)] -mt-1">BEST</span>
      </h1>

      <p class="mt-2 sm:mt-3 text-[clamp(1.7rem,4.9vw,2.5rem)] font-futura font-extrabold italic leading-[1.3] max-w-lg mx-auto text-center">
        <span class="block">Go solo or with a</span>
        <span class="block">friend, track your</span>
        <span class="block">fitness and beat</span>
        <span class="block">your best</span>
      </p>

    </div>
  </div>
</section>

<!-- SECTION 2: Directory -->
<section id="directory" class="bg-white pt-4 pb-8">

  <turbo-frame id="session_directory">

    <%= render "shared/narrow_container" do %>

      <%= form_with url: root_path,
                    method: :get,
                    data: { turbo_frame: "session_directory" } do %>

        <div class="space-y-0.5">

          <!-- CITY -->
          <%= render DropdownComponent.new(
            name: :city,
            options: @cities.to_a.compact,
            selected: @selected_city || @cities&.first || ""
          ) %>

          <!-- LOCATION -->
          <%= render DropdownComponent.new(
            name: :location_id,
            options: @locations.to_a.compact,
            selected: @locations&.find { |l| l.id == @selected_location_id } || @locations&.first || "",
            value_method: :id,
            label_method: :name
          ) %>

          <!-- SESSION TYPE -->
          <%= render DropdownComponent.new(
            name: :session_type_id,
            options: @available_session_types.to_a.compact,
            selected: @available_session_types&.find { |s| s.id == @selected_session_type_id } || @available_session_types&.first || "",
            value_method: :id,
            label_method: :title
          ) %>

          <!-- DATE -->
          <%= render DropdownComponent.new(
            name: :date,
            options: @available_dates.to_a.compact.map do |d|
              [formatted_session_date(d), d]
            end,
            selected: @available_dates&.find { |d| d == @selected_date } || @available_dates&.first || ""
          ) %>

        </div>

      <% end %>

      <!-- RESULTS -->
      <div class="pt-4 space-y-3">

        <% if @scheduled_sessions.present? %>
          <%= render "sessions/results",
              scheduled_sessions: @scheduled_sessions,
              time_slots: @time_slots %>
        <% else %>
          <div class="text-center text-gray-500 py-6">
            No sessions available for selected filters
          </div>
        <% end %>

      </div>

      <%= render "pages/about" %>

      <%= render "pages/faq" %>

    <% end %>

  </turbo-frame>

</section>
