<%= form_with model: [:admin, @session_type], local: true, data: { turbo: false }, class: "space-y-6" do |form| %>

  <% if @session_type.errors.any? %>
    <div class="bg-red-100 border border-red-300 text-red-700 p-4 rounded-lg">
      <h2 class="font-semibold mb-2">
        <%= pluralize(@session_type.errors.count, "error") %> prevented saving:
      </h2>
      <ul class="list-disc pl-5 text-sm">
        <% @session_type.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-semibold mb-1" %>
    <%= form.text_field :title,
        class: "w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-black focus:outline-none" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-semibold mb-1" %>
    <%= form.text_area :description,
        rows: 4,
        class: "w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-black focus:outline-none" %>
  </div>

  <div>
    <%= form.submit "Save Session Type",
        class: "bg-black text-white px-5 py-2 rounded-lg hover:bg-gray-800 transition" %>
  </div>

<% end %>
