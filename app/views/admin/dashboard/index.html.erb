<h1 class="text-2xl font-bold mb-6">Dashboard</h1>

<div class="grid md:grid-cols-2 gap-6">

  <!-- LOCATIONS -->
  <div class="bg-white rounded-xl shadow p-5">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold">Locations</h2>
      <%= link_to "New", new_admin_location_path,
          class: "text-sm bg-black text-white px-3 py-1 rounded" %>
    </div>

    <ul class="space-y-2">
      <% @locations.each do |location| %>
        <li class="flex justify-between items-center border-b pb-2">
          <span><%= location.name %></span>

          <div class="flex gap-3 text-sm">
            <%= link_to "Edit", edit_admin_location_path(location), class: "text-blue-600" %>
            <%= link_to "Schedule", schedule_admin_location_path(location), class: "text-green-600" %>
            <%= link_to "Delete", admin_location_path(location),
                data: { turbo_method: :delete, confirm: "Are you sure?" },
                class: "text-red-600" %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <!-- SESSION TYPES -->
  <div class="bg-white rounded-xl shadow p-5">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold">Session Types</h2>
      <%= link_to "New", new_admin_session_type_path,
          class: "text-sm bg-black text-white px-3 py-1 rounded" %>
    </div>

    <ul class="space-y-2">
      <% @session_types.each do |st| %>
        <li class="flex justify-between items-center border-b pb-2">
          <span><%= st.title %></span>

          <div class="flex gap-3 text-sm">
            <%= link_to "Edit", edit_admin_session_type_path(st), class: "text-blue-600" %>
            <%= link_to "Delete", admin_session_type_path(st),
                data: { turbo_method: :delete, confirm: "Are you sure?" },
                class: "text-red-600" %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

</div>
