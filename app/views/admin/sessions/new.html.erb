<h1 class="text-2xl font-bold mb-6">
  New Session for <%= @location.name %>
</h1>

<%= form_with model: [:admin, @location, @session], local: true, class: "space-y-6 max-w-lg" do |form| %>

  <div>
    <%= form.label :title, class: "block text-sm font-semibold mb-1" %>
    <%= form.text_field :title, class: "w-full border rounded-lg px-3 py-2" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-semibold mb-1" %>
    <%= form.text_area :description, rows: 4, class: "w-full border rounded-lg px-3 py-2" %>
  </div>

  <div>
    <%= form.label :date, class: "block text-sm font-semibold mb-1" %>
    <%= form.date_field :date, class: "w-full border rounded-lg px-3 py-2" %>
  </div>

  <div>
    <%= form.label :price, class: "block text-sm font-semibold mb-1" %>
    <%= form.number_field :price, step: 0.01, class: "w-full border rounded-lg px-3 py-2" %>
  </div>

  <%= form.submit "Create Session",
      class: "bg-black text-white px-5 py-2 rounded-lg hover:bg-gray-800" %>

<% end %>
