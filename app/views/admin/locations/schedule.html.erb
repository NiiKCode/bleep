<h1 class="text-2xl font-bold mb-6">
  <%= @location.name %> — Schedule
</h1>

<div class="grid lg:grid-cols-3 gap-6">

  <!-- UPCOMING -->
  <div class="bg-white rounded-xl shadow p-5">
    <h2 class="font-semibold mb-3">Upcoming</h2>

    <% @upcoming_sessions.each do |s| %>
      <div class="border-b py-3">
        <div class="font-medium">
          <%= s.date.strftime("%d %b %Y") %> — <%= s.session_type.title %>
        </div>

        <div class="text-sm text-gray-600 mb-2">
          £<%= s.price %>
        </div>

        <div class="flex gap-3 text-sm mb-2 items-center">
          <%= link_to "Add slot",
              new_admin_scheduled_session_time_slot_path(s),
              class: "text-green-600" %>

          <!-- DELETE SESSION -->
          <%= form_with url: delete_scheduled_session_admin_location_path(@location, session_id: s.id),
              method: :delete,
              local: true do %>
            <%= submit_tag "Delete",
                  data: { turbo_confirm: "Delete session?" },
                  class: "text-red-600 bg-transparent border-0 p-0 cursor-pointer" %>
          <% end %>
        </div>

        <% if s.time_slots.any? %>
          <ul class="text-sm text-gray-700">
            <% s.time_slots.each do |ts| %>
              <li class="flex justify-between items-center">
                <span>
                  <%= ts.start_time.strftime("%H:%M") %> - <%= ts.end_time.strftime("%H:%M") %>
                </span>

                <!-- DELETE TIME SLOT -->
                <%= form_with url: admin_scheduled_session_time_slot_path(s, ts),
                    method: :delete,
                    local: true do %>
                  <%= submit_tag "✕",
                        class: "text-red-500 bg-transparent border-0 p-0 cursor-pointer" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- CREATE -->
  <div class="bg-white rounded-xl shadow p-5">
    <h2 class="font-semibold mb-3">Add Date</h2>

    <%= form_with model: [:admin, @location, @scheduled_session],
        url: create_date_admin_location_path(@location),
        local: true do |f| %>

      <div class="mb-3">
        <%= f.label :date, class: "block text-sm" %>
        <%= f.date_field :date, class: "w-full border rounded p-2" %>
      </div>

      <div class="mb-3">
        <%= f.label :session_type_id, class: "block text-sm" %>
        <%= f.collection_select :session_type_id,
            SessionType.all, :id, :title,
            {}, class: "w-full border rounded p-2" %>
      </div>

      <div class="mb-3">
        <%= f.label :price, class: "block text-sm" %>
        <%= f.number_field :price, step: 0.01,
            class: "w-full border rounded p-2" %>
      </div>

      <%= f.submit "Create",
          class: "w-full bg-black text-white py-2 rounded" %>
    <% end %>
  </div>

  <!-- PAST -->
  <div class="bg-white rounded-xl shadow p-5">
    <h2 class="font-semibold mb-3">Past</h2>

    <% @past_sessions.each do |s| %>
      <div class="text-sm border-b py-2">
        <%= s.date.strftime("%d %b %Y") %> — <%= s.session_type.title %>
      </div>
    <% end %>
  </div>

</div>
