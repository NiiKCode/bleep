<!-- SECTION 3: Footer -->
<section class="px-6 pt-1 pb-6">
  <div class="w-full max-w-md mx-auto text-center space-y-6">

    <% if user_signed_in? %>
      <div class="flex justify-center">
        <%= button_to destroy_user_session_path,
              method: :delete,
              data: { turbo: false },
              title: "Logout",
              class: "flex justify-center items-center hover:opacity-60 transition cursor-pointer" do %>

          <svg xmlns="http://www.w3.org/2000/svg"
              class="w-7 h-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2">

            <!-- Arrow (LEFT, in front) -->
            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11 7l-5 5 5 5" />

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 12h8" />

            <!-- Door (flipped to face LEFT, positioned to the RIGHT with spacing) -->
            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M23 3h-4v18h4" />

          </svg>

        <% end %>
      </div>
    <% end %>

    <!-- Footer links -->
    <div class="text-base font-futura text-gray-700">
      <span>Privacy</span>
      <span class="px-2">|</span>
      <span>Terms</span>
      <span class="px-2">|</span>
      <span>Company Info</span>
    </div>

  </div>
</section>
