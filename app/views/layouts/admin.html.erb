<!DOCTYPE html>
<html>
  <head>
    <title>Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 text-gray-900">

    <div class="flex min-h-screen">

      <!-- Sidebar -->
      <aside class="w-64 bg-black text-white p-6 space-y-6">
        <h1 class="text-xl font-bold">Admin</h1>

        <nav class="space-y-2">
          <%= link_to "Dashboard", admin_dashboard_path, class: "block hover:underline" %>
          <%= link_to "Locations", admin_locations_path, class: "block hover:underline" %>
          <%= link_to "Session Types", admin_session_types_path, class: "block hover:underline" %>
        </nav>
      </aside>

      <!-- Main Content -->
      <main class="flex-1 p-8">
        <% if notice %>
          <div class="mb-4 p-3 bg-green-100 text-green-700 rounded">
            <%= notice %>
          </div>
        <% end %>

        <% if alert %>
          <div class="mb-4 p-3 bg-red-100 text-red-700 rounded">
            <%= alert %>
          </div>
        <% end %>

        <%= yield %>
      </main>

    </div>

  </body>
</html>
