<% scheduled_sessions.each do |session| %>

  <% session.time_slots.order(:start_time).each do |time_slot| %>

    <div
      class="flex items-start justify-between py-6 border-b"
      data-controller="session-info"
    >

      <div>

        <div class="font-futura-heavy-italic text-2xl">
          <%= time_slot.start_time.strftime("%H.%M") %>
          to
          <%= time_slot.end_time.strftime("%H.%M") %>
        </div>

        <div class="mt-2">

          <div class="flex items-center gap-2">

            <span class="text-fuchsia-500 font-bold text-xl">
              <%= session.session_type.title %>
            </span>

            <button
              type="button"
              data-action="click->session-info#toggle"
              class="
                w-6
                h-6
                rounded-full
                border
                border-black
                text-sm
                italic
                flex
                items-center
                justify-center
              "
            >
              i
            </button>

          </div>

          <div class="mt-1 font-futura-heavy-italic text-base">
            £<%= number_to_currency(session.price, unit: "", precision: 0) %>
          </div>

          <div
            data-session-info-target="content"
            class="hidden mt-3 text-sm text-gray-600 leading-relaxed max-w-sm"
          >
            <%= session.session_type.description %>
          </div>

        </div>

      </div>

      <%= link_to "BOOK",
            new_booking_path(time_slot_id: time_slot.id),
            data: { turbo_frame: "_top" },
            class: "book-button book-button-primary" %>

    </div>

  <% end %>

<% end %>
