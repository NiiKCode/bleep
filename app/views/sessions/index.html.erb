<%= form_with url: sessions_path, method: :get, local: true do %>

  <!-- Location -->
  <div class="border-b py-4">

    <label class="block text-lg font-bold">
      Location
    </label>

    <%= select_tag :location_id,
          options_from_collection_for_select(
            @locations,
            :id,
            :display_name,
            @selected_location_id
          ),
          include_blank: "Select a location",
          class: "w-full text-lg font-semibold bg-transparent border-0 focus:ring-0",
          onchange: "this.form.requestSubmit()" %>

  </div>

  <!-- DATE CAROUSEL -->
  <% if @available_dates.present? %>

    <div class="py-6">

      <%= render DateCarouselComponent.new(
        dates: @available_dates,
        selected_date: @selected_date
      ) %>

    </div>

  <% end %>

<% end %>

<div class="pt-6 space-y-4">

  <%= render "results",
        scheduled_sessions: @scheduled_sessions,
        time_slots: @time_slots %>

</div>
